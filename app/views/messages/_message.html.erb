<%# stories 5 (hear the characters), 6 (unblur the text), 8 (see feedback on typed messages), 16 - (click and translate) %>

<div class="message-row message-row--<%= message.role %>">
  <% if message.role == "assistant" && message.adventure.character.image.attached? %>
    <%= image_tag message.adventure.character.image, class: "message-row__avatar", alt: message.adventure.character.name %>
  <% end %>
  <div class="message message--<%= message.role %>" id="<%= dom_id(message) %>">
  <% if message.role == "assistant" %>
    <%# story 5: audio plays; story 6: text starts blurred %>
    <span data-controller="audio-player" data-audio-player-url-value="<%= audio_message_path(message) %>">
      <button type="button" data-action="audio-player#play" class="btn-audio">▶ Listen</button>
    </span>

    <p class="blurred" data-blur-target="text">
      <%= message.body %>
    </p>
    <button data-action="blur#toggle" class="btn-reveal">
      Reveal text
    </button>
  <% else %>
    <p><%= message.body %></p>

    <%# story 8 — feedback on what I typed %>
    <% if message.feedback %>
      <%= link_to "See feedback", message_feedback_path(message),
                  data: { turbo_frame: dom_id(message, :feedback) } %>
      <turbo-frame id="<%= dom_id(message, :feedback) %>"></turbo-frame>
    <% end %>
  <% end %>

    <%# story 16 - click and translate %>
    <%= link_to "Translate", translate_message_path(message),
                data: { turbo_stream: true }, class: "btn-link" %>
  </div>
</div>

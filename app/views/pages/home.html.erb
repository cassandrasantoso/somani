<%# story 3 - see the adventures %>
<h1>Choose an adventure</h1>

<div class="scene-grid">
  <% @scenes.each do |scene| %>
    <div class="scene-card">
      <h2><%= scene.setting %></h2>
      <p class="level"><%= scene.level %></p>
      <p><%= scene.description %></p>
      <p class="character">With <%= scene.character.name %></p>
    </div>
  <% end %>
</div>

<% if user_signed_in? %>
  <h2>Start from your material</h2>
  <%= link_to "Upload something new", new_upload_path, class: "btn" %>
  <ul>
    <% @uploads.each do |upload| %>
      <li>
        <%= link_to upload.file.filename, upload %>
        <%= link_to "Start an adventure", new_upload_adventure_path(upload) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= link_to "Sign up", new_user_registration_path, class: "btn" %>
<% end %>

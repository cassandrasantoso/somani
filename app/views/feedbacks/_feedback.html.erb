<div id="<%= dom_id(message, :feedback) %>" class="msg-feedback">
  <% fb = message.feedback %>

  <% if fb.nil? %>
    <% if message.too_short_for_feedback? %>
      <p class="msg-feedback__hint">No suggestions for short replies (under <%= ReviewMessageJob::MIN_LENGTH %> characters).</p>
    <% end %>
    <%# Otherwise nothing yet. The container still renders so the broadcast has a target. %>

  <% else %>
    <% if fb.disconnected? %>
      <p class="msg-feedback__coherence msg-feedback__coherence--<%= fb.coherence %>">
        <i class="fa-solid fa-comment-slash" aria-hidden="true"></i>
        <%= fb.coherence_note.presence || "This doesn't quite answer what was asked." %>
      </p>
    <% end %>

    <% if fb.clean? %>
      <% unless fb.disconnected? %>
        <p class="msg-feedback__clean">✓ <%= fb.assessment %></p>
      <% end %>
    <% else %>
      <details class="msg-feedback__details">
      <summary class="msg-feedback__summary">
        <%= pluralize(fb.corrections.size, "suggestion") %>
      </summary>

      <p class="msg-feedback__assessment"><%= fb.assessment %></p>

      <ul class="msg-feedback__list">
        <% fb.corrections.each do |c| %>
          <li class="msg-feedback__item">
            <span class="msg-feedback__kind msg-feedback__kind--<%= c["kind"] %>">
              <%= c["kind"] %>
            </span>
            <span class="msg-feedback__wrote"><%= c["wrote"] %></span>
            <span class="msg-feedback__arrow" aria-hidden="true">→</span>
            <span class="msg-feedback__better"><%= c["better"] %></span>
            <p class="msg-feedback__why"><%= c["why"] %></p>
          </li>
        <% end %>
      </ul>
      </details>
    <% end %>
  <% end %>
</div>

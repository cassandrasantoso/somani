<nav class="app-navbar">
  <div class="app-navbar__inner">
    <button class="app-navbar__icon-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#appMenu" aria-controls="appMenu" aria-label="Open menu">
      <i class="fa-solid fa-bars"></i>
    </button>

    <%= link_to root_path, class: "app-navbar__brand" do %>
      <span class="app-navbar__logo-crop">
        <%= image_tag "logo.png", alt: "", class: "app-navbar__logo" %>
      </span>
      <span class="app-navbar__wordmark">SOMANI</span>
    <% end %>

    <%= link_to (user_signed_in? ? edit_settings_path : new_user_session_path), class: "app-navbar__icon-btn", "aria-label": "Notifications" do %>
      <i class="fa-solid fa-bell"></i>
    <% end %>
  </div>
</nav>

<div class="offcanvas offcanvas-start app-menu" tabindex="-1" id="appMenu" aria-labelledby="appMenuLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="appMenuLabel">Menu</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <ul class="app-menu__list">
      <li><%= link_to "Home", root_path %></li>
      <% if user_signed_in? %>
        <li><%= link_to "Saved words", saved_words_path %></li>
        <li><%= link_to "Uploads", uploads_path %></li>
        <li><%= link_to "Settings", edit_settings_path %></li>
        <li><%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete } %></li>
      <% else %>
        <li><%= link_to "Log in", new_user_session_path %></li>
        <li><%= link_to "Sign up", new_user_registration_path %></li>
      <% end %>
    </ul>
  </div>
</div>

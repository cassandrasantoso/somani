<div class="auth-page auth-page--sakura">
  <div class="sakura-fall" aria-hidden="true">
    <% 14.times do %>
      <span class="sakura-fall__petal"></span>
    <% end %>
  </div>

  <%= render "devise/shared/tagline" %>

  <div class="auth-card">
    <h1 class="auth-card__title">Log in</h1>
    <p class="auth-card__subtitle">Welcome back! Enter your details to continue.</p>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-inputs">
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>
        <%= f.input :password,
                    required: false,
                    input_html: { autocomplete: "current-password" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Log in", class: "auth-form__submit" %>
      </div>
    <% end %>

    <div class="auth-card__links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>

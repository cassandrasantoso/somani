  <div id="word-picker" data-controller="word-picker" data-word-picker-already-saved-value="<%= already_saved_surfaces.to_json %>"
    data-action="turbo:submit-end->word-picker#closeModal">
    <div class="upload-card">
      <h2 class="upload-card__title">Study Material<br>読み取ったテキスト</h2>
      <p class="extracted" data-word-picker-target="text"
        data-action="mouseup->word-picker#capture">
        <%= highlight_jlpt_matches(upload.extracted_text, matched_entries) %>
      </p>
      <p class="upload-card__hint">Tap a highlighted word to view and add it to your study list.</p>
    </div>
  <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true"
    data-action="show.bs.modal->word-picker#prefill">
      <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Save to Vocabulary List</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= simple_form_for [upload, SavedWord.new] do |f| %>
      <div class="modal-body upload-card m-1 mt-3">
        <%= f.input :surface, input_html: { data: { word_picker_target: "surface" } } %>
        <%= f.input :reading, input_html: { data: { word_picker_target: "reading" } } %>
        <%= f.input :meaning, input_html: { data: { word_picker_target: "meaning" } } %>
        <%= f.input :level, collection: %w[N5 N4 N3 N2 N1], input_html: { data: { word_picker_target: "level" } } %>
        <div class="mb-3">
          <label class="form-label word-target-field__label" for="target">How many times do you want to use this word?</label>
          <p class="word-target-field__hint">Pick how many times you want to use each word.</p>
          <%= select_tag :target,
                        options_for_select(WordGoal::RANGE, WordGoal::DEFAULT_TARGET),
                        class: "form-select",
                        data: { word_picker_target: "times" } %>
        </div>
        <div class="">
          <label class="form-label">Pronunciation</label>
          <button type="button" class="pronunciation-field__btn" data-action="word-picker#playPronunciation">
            ▶ Listen
          </button>
        </div>
      </div>
      <div class="modal-footer">
        <%= f.submit "Save this word", class: "upload-form__submit" %>
      </div>
      <% end %>
    </div>
  </div>

  </div>
</div>

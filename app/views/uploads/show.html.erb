<%# story 2 - can select words/phrases from the scanned content %>
<details class="upload-preview mt-2">
  <summary class="upload-show__header">
      <div>
        <p class="upload-show__eyebrow">Reading practice</p>
      </div>


    <span class="upload-preview__toggle">
      <span class="upload-preview__toggle-text">View uploaded photo</span>

      <i
        class="fa-solid fa-chevron-down upload-preview__chevron"
        aria-hidden="true"
      ></i>
    </span>
  </summary>

  <div class="upload-preview__content">
    <% if @upload.media_type == "photo" %>
      <div class="upload-card">
        <%= image_tag @upload.file_location,
                      class: "upload-card__image",
                      alt: "Uploaded Japanese text" %>
      </div>
    <% end %>
  </div>
</details>

  <%# AI-generated summary %>
  <% if @upload.summary.present? %>
    <section class="upload-insight">
      <div class="upload-insight__icon" aria-hidden="true">
         <%= image_tag "somani_bird.png",
                    class: "upload-insight__bird",
                    alt: "Somani bird" %>
      </div>

      <p class="upload-insight__text">
        <%= @upload.summary %>
      </p>
    </section>
  <% end %>

  <section class="upload-section upload-section--words">
      <div class="upload-section__heading">
        <div>
          <p class="upload-section__eyebrow">Vocabulary finder</p>
          <h2>Select words to study</h2>
          <p class="upload-section__description">
            Tap a highlighted word to add it to your study list.
          </p>
        </div>
      </div>

      <div class="jlpt-legend">
        <span class="jlpt-legend__item" data-level="N5">N5</span>
        <span class="jlpt-legend__item" data-level="N4">N4</span>
        <span class="jlpt-legend__item" data-level="N3">N3</span>
        <span class="jlpt-legend__item" data-level="N2">N2</span>
        <span class="jlpt-legend__item" data-level="N1">N1</span>
      </div>

      <%= render "word_picker",
                upload: @upload,
                matched_entries: @matched_entries,
                already_saved_surfaces: @already_saved_surfaces %>
  </section>


    <section class="upload-section upload-section--saved">
      <div class="upload-section__heading">
        <div>
          <p class="upload-section__eyebrow">Your collection</p>
          <h2>Saved words</h2>
        </div>

        <span class="upload-section__count">
          <%= pluralize(@saved_words.size, "word") %>
        </span>
      </div>

      <%= render "saved_words/list",
                upload: @upload,
                saved_words: @saved_words,
                word_targets: @word_targets %>
    </section>

  <% if policy(@upload).start_adventure? %>
    <div data-controller="upload-form" data-action="turbo:submit-end@document->upload-form#hideLoading">
      <div class="upload-show__actions mt-3">
        <%= button_to "Start an adventure! 🗺️",
                    upload_adventures_path(@upload),
                    method: :post,
                    class: "upload-show__btn upload-show__btn--primary",
                    form: { data: { action: "submit->upload-form#showLoading" } } %>
      </div>

      <div class="upload-loading" data-upload-form-target="overlay" hidden>
        <div class="upload-loading__card">
          <%= image_tag "uploading.jpeg", class: "upload-loading__bird", alt: "" %>
          <p class="upload-loading__text">
            Starting your adventure...
            <span class="upload-loading__percent" data-upload-form-target="percent">0%</span>
          </p>
          <div class="upload-loading__bar">
            <div class="upload-loading__bar-fill" data-upload-form-target="barFill"></div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="upload-show__actions mt-3">
    <% if policy(@upload).destroy? %>
      <%= button_to "Delete upload", @upload, method: :delete, class: "upload-show__btn upload-show__btn--danger" %>
    <% end %>
  </div>

<div class="container py-3">
  <h1 class="mb-3">Your Uploads</h1>

  <% if @uploads.any? %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
      <% @uploads.each do |upload| %>
        <div class="col">
          <div class="card h-100 shadow-sm position-relative upload-tile">
            <% if upload.media_type == "audio" %>
              <div class="card-img-top upload-tile__image upload-tile__image--placeholder d-flex align-items-center justify-content-center">
                <i class="fa-solid fa-music fa-2x"></i>
              </div>
            <% else %>
              <%= image_tag upload.file_location, class: "card-img-top upload-tile__image object-fit-cover", alt: "" %>
            <% end %>

            <div class="card-body d-flex flex-column">
              <span class="badge text-bg-primary align-self-start mb-2"><%= upload.media_type.capitalize %></span>

              <p class="card-text upload-tile__text"><%= upload.extracted_text %></p>

              <% if upload.adventures.any? %>
                <div class="mt-auto pt-2 d-flex flex-wrap gap-1">
                  <% upload.adventures.each do |adventure| %>
                    <span class="badge <%= adventure.status == "active" ? "text-bg-success" : "text-bg-secondary" %>">
                      <%= adventure.title.presence || adventure.scene.setting %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>

            <%= link_to "", upload_path(upload), class: "stretched-link", "aria-label": "View upload" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">No uploads yet.</p>
  <% end %>
</div>

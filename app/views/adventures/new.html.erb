<%# story 12 - create a new adventure %>
<div class="adventure-setup">

  <!-- Header & Context Banner -->
  <div class="adventure-setup__header">
    <span class="adventure-setup__badge">📖 Vocabulary Source</span>
    <h1 class="adventure-setup__title">Start a New Adventure</h1>
    <p class="adventure-setup__subtitle">
      Generate an interactive story using vocabulary extracted from
      <strong><%= @upload.file.filename %></strong>.
    </p>
  </div>

  <!-- Form Card -->
  <div class="adventure-setup__card">
    <%= simple_form_for [@upload, @adventure] do |f| %>

      <!-- Adventure Title Input -->
      <div class="adventure-setup__field">
        <%= f.input :title,
                    label: "Adventure Title",
                    placeholder: "e.g., NHK News Article...Meeting notes...",
                    label_html: { class: "adventure-setup__label" },
                    input_html: { class: "form-control" } %>
      </div>

      <!-- Scene Selection -->
      <div class="adventure-setup__field">
        <label class="adventure-setup__label">Select Your Setting &amp; Character</label>

        <%= f.input :scene_id,
                    as: :radio_buttons,
                    collection: @scenes,
                    label: false,
                    wrapper_html: { class: "scene-grid" },
                    item_wrapper_class: "scene-card-wrapper",
                    label_method: ->(s) {
                      avatar_html = if s.character.image.attached?
                        image_tag(s.character.image, class: "scene-card__avatar", alt: s.character.name)
                      else
                        %Q(<span class="scene-card__avatar scene-card__avatar--placeholder">#{ERB::Util.html_escape(s.character.name.first)}</span>)
                      end

                      raw(%Q(
                        <div class="scene-card__content">
                          <div class="scene-card__info">
                            #{avatar_html}
                            <div>
                              <div class="scene-card__setting">#{ERB::Util.html_escape(s.setting)}</div>
                              <div class="scene-card__character">Character: <strong>#{ERB::Util.html_escape(s.character.name)}</strong></div>
                            </div>
                          </div>
                          <span class="badge level-badge level-badge--#{s.level.to_s.downcase}">
                            #{s.level}
                          </span>
                        </div>
                      ))
                    } %>
      </div>

      <!-- Submit Action -->
      <%= f.submit "Begin Adventure ⚔️", class: "adventure-setup__submit" %>
    <% end %>
  </div>
</div>

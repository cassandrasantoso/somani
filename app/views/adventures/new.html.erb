<%# story 12 - create a new adventure %>
<h1>New adventure</h1>
<p>Using words from <%= @upload.file.filename %></p>

<%= simple_form_for [@upload, @adventure] do |f| %>
  <%= f.input :title %>
  <%= f.input :scene_id, collection: @scenes,
              label_method: ->(s) { "#{s.setting} (#{s.level}) — #{s.character.name}" },
              as: :radio_buttons %>
  <%= f.submit "Begin", class: "btn" %>
<% end %>

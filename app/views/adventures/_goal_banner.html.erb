<div id="goal-banner"><% if adventure.prompt_goal? %>
  <div class="goal-bar">
    <span class="goal-bar__text">Goal reached — every word used.</span>

    <span class="goal-bar__actions">
      <%= button_to "Finish", adventure_path(adventure, adventure: { status: "completed" }),
                    method: :patch, class: "goal-bar__btn goal-bar__btn--primary" %>
      <%= button_to "Keep going", continue_adventure_path(adventure),
                    method: :patch, class: "goal-bar__btn" %>
    </span>
  </div>
<% end %></div>

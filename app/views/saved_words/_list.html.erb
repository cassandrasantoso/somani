<div id="saved-word-list" class="upload-card mt-3 mx-3">
  <h2 class="upload-card__title">📕 Words from this upload</h2>

  <% if saved_words.any? %>
    <ul class="saved-word-list">
      <% saved_words.each do |word| %>
        <% edit_data = {
             bs_toggle: "modal",
             bs_target: "#exampleModal",
             surface: word.surface,
             reading: word.reading,
             meaning: word.meaning,
             level: word.level,
             times: word_targets.fetch(word.id, WordGoal::DEFAULT_TARGET)
           } %>
        <li class="saved-word">
          <div class="saved-word__info">
            <div class="saved-word__surface-row">
              <%= tag.button type: "button", class: "saved-word__surface-btn", data: edit_data do %>
                <span class="saved-word__surface"><%= word.surface %></span>
                <% if word.level.present? %>
                  <span class="badge level-badge level-badge--<%= word.level.to_s.downcase %>"><%= word.level %></span>
                <% end %>
              <% end %>
              <%= tag.button "Edit", type: "button", class: "saved-word__edit", data: edit_data %>
            </div>
            <span class="saved-word__meaning"><%= word.meaning %></span>
          </div>
          <%= link_to "Details", saved_word_path(word), class: "saved-word__details" %>
          <% link = word.uploaded_words.find_by(upload: upload) %>
          <% if link && policy(link).destroy? %>
            <%= button_to "Remove", uploaded_word_path(link), method: :delete, class: "saved-word__remove" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="upload-show__empty">No words saved from this upload yet.</p>
  <% end %>
</div>



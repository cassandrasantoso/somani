<div class="reading-drill" id="reading-drill-<%= passage.id %>" data-controller="reading-drill"
     data-reading-drill-attempt-url-value="<%= reading_passage_reading_attempts_path(passage) %>">

  <div class="reading-drill__header">
    <p class="reading-drill__eyebrow">速読 Speed reading · Passage <%= passage.position %></p>

    <% if previous %>
      <p class="reading-drill__best">
        Last: <%= previous.wpm %> chars/min · <%= previous.comprehension %>% comprehension —
        next target <strong><%= previous.next_target_wpm %></strong>
      </p>
    <% else %>
      <p class="reading-drill__best">First run — set your baseline.</p>
    <% end %>
  </div>

  <div class="reading-drill__stages">
    <div class="reading-drill__stage reading-drill__stage--intro" data-reading-drill-target="intro">
      <p><%= passage.char_count %> characters. Read it once at your natural speed, then answer <%= passage.questions.size %> questions.</p>
      <p class="reading-drill__hint">Speed without comprehension doesn't count — the quiz grades both.</p>
      <button type="button" class="reading-drill__btn reading-drill__btn--primary" data-action="reading-drill#start">Start reading</button>
    </div>

    <div class="reading-drill__stage" data-reading-drill-target="reading" hidden>
      <p class="reading-drill__timer"><span data-reading-drill-target="timer">0.0</span>s</p>
      <div class="reading-drill__passage">
        <%= passage.text %>
      </div>
      <button type="button" class="reading-drill__btn reading-drill__btn--primary" data-action="reading-drill#finish">Finished</button>
    </div>

    <div class="reading-drill__stage" data-reading-drill-target="quiz" hidden>
      <h3>Comprehension check</h3>

      <% passage.questions.each_with_index do |question, qi| %>
        <fieldset class="reading-drill__question">
          <legend><%= question["q"] %></legend>
          <% question["options"].each_with_index do |option, oi| %>
            <label class="reading-drill__option">
              <input type="radio" name="question-<%= qi %>" value="<%= oi %>" required>
              <%= option %>
            </label>
          <% end %>
        </fieldset>
      <% end %>

      <button type="button" class="reading-drill__btn reading-drill__btn--primary" data-action="reading-drill#submit">Submit</button>
    </div>
  </div>
</div>

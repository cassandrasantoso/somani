CLOUDINARY_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash-lite
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SENTRY_DSN=
DAILY_MESSAGE_LIMIT=100
DAILY_UPLOAD_LIMIT=10

# Which chat provider Llm routes to: gemini (default) or openai.
LLM_PROVIDER=gemini

# OpenAI-compatible provider (also covers OpenRouter, Groq, Ollama, vLLM —
# anything speaking the chat-completions API). Ignored when LLM_PROVIDER=gemini.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_LITE_MODEL=gpt-4o-mini
